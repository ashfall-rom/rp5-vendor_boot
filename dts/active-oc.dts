			qcom,iommu-dma = "disabled";
			iommus = <0xdc 0x05 0x400>;
			interrupt-names = "kgsl_hfi_irq\0kgsl_gmu_irq";
			interrupts = <0x00 0x130 0x04 0x00 0x131 0x04>;
			reg-names = "kgsl_gmu_reg\0kgsl_gmu_pdc_cfg\0kgsl_gmu_pdc_seq";
			reg = <0x3d6a000 0x30000 0xb290000 0x10000 0xb490000 0x10000>;
			compatible = "qcom,gpu-gmu";
		};
	};

	psci {
		compatible = "arm,psci-1.0";
		method = "smc";

		cpu-pd0 {
			#power-domain-cells = <0x00>;
			power-domains = <0x6b>;
			phandle = <0x04>;
		};

		cpu-pd1 {
			#power-domain-cells = <0x00>;
			power-domains = <0x6b>;
			phandle = <0x08>;
		};

		cpu-pd2 {
			#power-domain-cells = <0x00>;
			power-domains = <0x6b>;
			phandle = <0x0a>;
		};

		cpu-pd3 {
			#power-domain-cells = <0x00>;
			power-domains = <0x6b>;
			phandle = <0x0c>;
		};

		cpu-pd4 {
			#power-domain-cells = <0x00>;
			power-domains = <0x6b>;
			phandle = <0x0f>;
		};

		cpu-pd5 {
			#power-domain-cells = <0x00>;
			power-domains = <0x6b>;
			phandle = <0x11>;
		};

		cpu-pd6 {
			#power-domain-cells = <0x00>;
			power-domains = <0x6b>;
			phandle = <0x13>;
		};

		cpu-pd7 {
			#power-domain-cells = <0x00>;
			power-domains = <0x6b>;
			phandle = <0x15>;
		};

		cluster-pd {
			#power-domain-cells = <0x00>;
			domain-idle-states = <0x214>;
			phandle = <0x6b>;
		};
	};

	firmware {
		phandle = <0x4b1>;

		qcom_scm {
			compatible = "qcom,scm";
			qcom,dload-mode = <0x215 0x13000>;
		};

		qtee_shmbridge {
			compatible = "qcom,tee-shared-memory-bridge";
		};

		qcom_smcinvoke {
			compatible = "qcom,smcinvoke";
		};

		android {
			compatible = "android,firmware";

			vbmeta {
				compatible = "android,vbmeta";
				parts = "vbmeta,boot,system,vendor,dtbo,recovery";
			};

			fstab {
				compatible = "android,fstab";

				vendor {
					compatible = "android,vendor";
					dev = "/dev/block/platform/soc/1d84000.ufshc/by-name/vendor";
					type = "ext4";
					mnt_flags = "ro,barrier=1,discard";
					fsmgr_flags = "wait,slotselect,avb";
					status = "ok";
				};
			};
		};
	};

