/dts-v1/;

/ {
	model = "Qualcomm Technologies, Inc. kona-iot nopm v2.1 SoC";
	compatible = "qcom,kona-iot";
	qcom,msm-id = <0x164 0x20001 0x1e1 0x20001>;
	interrupt-parent = <0x01>;
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	qcom,board-id = <0x00 0x00>;
	qcom,pmic-id = <0x1e 0x20 0x1f 0x21 0x00 0x00>;
	qcom,oem-id = <0x24>;

	memory {
		device_type = "memory";
		reg = <0x00 0x00 0x00 0x00>;
	};

	ddr-regions {
	};

	chosen {
		bootargs = "console=ttyMSM0,115200n8 loglevel=6 kpti=0 log_buf_len=256K kernel.panic_on_rcu_stall=1 rcupdate.rcu_expedited=1 rcu_nocbs=0-7 ftrace_dump_on_oops fw_devlink.strict=1 cpufreq.default_governor=performance printk.console_no_auto_verbose=1 kasan=off pcie_ports=compat qcom_dma_heaps.enable_bitstream_contig_heap=y";
	};

	mem-offline {
		compatible = "qcom,mem-offline";
		offline-sizes = <0x01 0x40000000 0x00 0x40000000 0x01 0xc0000000 0x00 0x80000000 0x02 0xc0000000 0x01 0x40000000>;
		granule = <0x200>;
		mboxes = <0x02 0x00>;
		ddr-old-version;
	};

	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;
		phandle = <0x216>;

		hyp_region@80000000 {
			no-map;
			reg = <0x00 0x80000000 0x00 0x600000>;
			phandle = <0x217>;
		};

		xbl_aop_region@80700000 {
			no-map;
			reg = <0x00 0x80700000 0x00 0x160000>;
			phandle = <0x218>;
		};

		reserved-memory@80860000 {
			reg = <0x00 0x80860000 0x00 0x20000>;
			compatible = "qcom,cmd-db";
			no-map;
			phandle = <0x219>;
		};

		smem_region@80900000 {
			no-map;
			reg = <0x00 0x80900000 0x00 0x200000>;
			phandle = <0xa0>;
		};

		removed_region@80b00000 {
			no-map;
			reg = <0x00 0x80b00000 0x00 0x5300000>;
			phandle = <0x21a>;
		};

		pil_camera_region@86200000 {
			no-map;
			reg = <0x00 0x86200000 0x00 0x500000>;
			phandle = <0x21b>;
		};

		pil_wlan_fw_region@86700000 {
			no-map;
			reg = <0x00 0x86700000 0x00 0x100000>;
			phandle = <0x21c>;
		};

		pil_ipa_fw_region@86800000 {
			no-map;
			reg = <0x00 0x86800000 0x00 0x10000>;
			phandle = <0x21d>;
		};

		pil_ipa_gsi_region@86810000 {
			no-map;
			reg = <0x00 0x86810000 0x00 0xa000>;
			phandle = <0x21e>;
		};

		pil_gpu_region@8681a000 {
			no-map;
			reg = <0x00 0x8681a000 0x00 0x2000>;
			phandle = <0x21f>;
		};

		pil_npu_region@86900000 {
			no-map;
			reg = <0x00 0x86900000 0x00 0x500000>;
			phandle = <0xb3>;
		};

		video_region@86e00000 {
			no-map;
			reg = <0x00 0x86e00000 0x00 0x500000>;
			phandle = <0x220>;
		};

		pil_cvp_region@87300000 {
			no-map;
			reg = <0x00 0x87300000 0x00 0x500000>;
			phandle = <0x221>;
		};

		rproc_cdsp_region@87800000 {
			no-map;
			reg = <0x00 0x87800000 0x00 0x1400000>;
			phandle = <0xab>;
		};

		rproc_slpi_region@88c00000 {
			no-map;
			reg = <0x00 0x88c00000 0x00 0x1500000>;
			phandle = <0xaf>;
		};

		rproc_adsp_region@8a100000 {
			no-map;
			reg = <0x00 0x8a100000 0x00 0x1d00000>;
			phandle = <0xa8>;
		};

		rproc_spss_region@8be00000 {
			no-map;
			reg = <0x00 0x8be00000 0x00 0x100000>;
			phandle = <0xb2>;
		};

		cdsp_secure_heap@8bf00000 {
			no-map;
			reg = <0x00 0x8bf00000 0x00 0x4600000>;
			phandle = <0xde>;
		};

		adsp_region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0xc00000>;
			phandle = <0xb9>;
		};

		sdsp_region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0x800000>;
			phandle = <0xdd>;
		};

		cdsp_region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0x400000>;
			phandle = <0x222>;
		};

		cont_splash_region@9c000000 {
			reg = <0x00 0x9c000000 0x00 0x2300000>;
			label = "cont_splash_region";
			phandle = <0x223>;
		};

		disp_rdump_region@9c000000 {
			reg = <0x00 0x9c000000 0x00 0x800000>;
			label = "disp_rdump_region";
			phandle = <0x224>;
		};

		dfps_data_region@9e300000 {
			reg = <0x00 0x9e300000 0x00 0x100000>;
			label = "dfps_data_region";
			phandle = <0x225>;
		};

		mem_dump_region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			size = <0x00 0x2800000>;
			phandle = <0xa5>;
		};

		sp_region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0x1000000>;
			phandle = <0xdf>;
		};

		user_contig_region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0x1000000>;
			phandle = <0x59>;
		};

		qseecom_region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0x1400000>;
			phandle = <0x57>;
		};

		qseecom_ta_region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0x1000000>;
			phandle = <0x58>;
		};

		secure_display_region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0xa400000>;
			phandle = <0xe0>;
		};

		cnss_wlan_region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0x1400000>;
			phandle = <0x226>;
		};

		linux,cma {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0x2000000>;
			linux,cma-default;
			phandle = <0xdb>;
		};

		mailbox_region {
			compatible = "shared-dma-pool";
			no-map;
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			alignment = <0x00 0x400000>;
			size = <0x00 0x20000>;
			phandle = <0x227>;
		};

		vendor {
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			ranges = <0x00 0x00 0x00 0xffffffff>;
			compatible = "simple-bus";
			phandle = <0x228>;
		};
	};

	aliases {
		ufshc1 = "/soc/ufshc@1d84000";
		serial0 = "/soc/qcom,qupv3_1_geni_se@ac0000/qcom,qup_uart@a90000";
		hsuart0 = "/soc/qcom,qupv3_0_geni_se@9c0000/qcom,qup_uart@998000";
		hsuart1 = "/soc/qcom,qupv3_2_geni_se@8c0000/qcom,qup_uart@888000";
		pci-domain0 = "/soc/qcom,pcie@1c00000";
		pci-domain1 = "/soc/qcom,pcie@1c08000";
		pci-domain2 = "/soc/qcom,pcie@1c10000";
		mmc1 = "/soc/sdhci@8804000";
		usb0 = "/soc/ssusb@a600000/dwc3@a600000";
		usb1 = "/soc/ssusb@a800000/dwc3@a800000";
		phandle = <0x229>;
	};

	cpus {
		#address-cells = <0x02>;
		#size-cells = <0x00>;

		cpu@0 {
			device_type = "cpu";
			compatible = "qcom,kryo";
			reg = <0x00 0x00>;
			enable-method = "psci";
			cpu-idle-states = <0x03>;
			power-domains = <0x04>;
			power-domain-names = "psci";
			cpu-release-addr = <0x00 0x90000000>;
			next-level-cache = <0x05>;
			qcom,freq-domain = <0x06 0x00>;
			capacity-dmips-mhz = <0x400>;
			dynamic-power-coefficient = <0x64>;
			#cooling-cells = <0x02>;
			phandle = <0x17>;

			l2-cache {
				compatible = "arm,arch-cache";
				cache-level = <0x02>;
				next-level-cache = <0x07>;
				phandle = <0x05>;

				l3-cache {
					compatible = "arm,arch-cache";
					cache-level = <0x03>;
					phandle = <0x07>;
				};
			};

			l1-icache {
				compatible = "arm,arch-cache";
				phandle = <0x22a>;
			};

			l1-dcache {
				compatible = "arm,arch-cache";
				phandle = <0x22b>;
			};
		};

		cpu@100 {
			device_type = "cpu";
			compatible = "qcom,kryo";
			reg = <0x00 0x100>;
			enable-method = "psci";
			cpu-idle-states = <0x03>;
			power-domains = <0x08>;
			power-domain-names = "psci";
			cpu-release-addr = <0x00 0x90000000>;
			next-level-cache = <0x09>;
			qcom,freq-domain = <0x06 0x00>;
			capacity-dmips-mhz = <0x400>;
			dynamic-power-coefficient = <0x64>;
			phandle = <0x18>;

			l2-cache {
				compatible = "arm,arch-cache";
				cache-level = <0x02>;
				next-level-cache = <0x07>;
				phandle = <0x09>;
			};

			l1-icache {
				compatible = "arm,arch-cache";
				phandle = <0x22c>;
			};

			l1-dcache {
				compatible = "arm,arch-cache";
				phandle = <0x22d>;
			};
		};

		cpu@200 {
			device_type = "cpu";
			compatible = "qcom,kryo";
			reg = <0x00 0x200>;
			enable-method = "psci";
			cpu-idle-states = <0x03>;
			power-domains = <0x0a>;
			power-domain-names = "psci";
			cpu-release-addr = <0x00 0x90000000>;
			next-level-cache = <0x0b>;
			qcom,freq-domain = <0x06 0x00>;
			capacity-dmips-mhz = <0x400>;
			dynamic-power-coefficient = <0x64>;
			phandle = <0x19>;

			l2-cache {
				compatible = "arm,arch-cache";
				cache-level = <0x02>;
				next-level-cache = <0x07>;
				phandle = <0x0b>;
			};

			l1-icache {
				compatible = "arm,arch-cache";
				phandle = <0x22e>;
			};

			l1-dcache {
				compatible = "arm,arch-cache";
				phandle = <0x22f>;
			};
		};

		cpu@300 {
			device_type = "cpu";
			compatible = "qcom,kryo";
			reg = <0x00 0x300>;
			enable-method = "psci";
			cpu-idle-states = <0x03>;
			power-domains = <0x0c>;
			power-domain-names = "psci";
			cpu-release-addr = <0x00 0x90000000>;
			next-level-cache = <0x0d>;
			qcom,freq-domain = <0x06 0x00>;
			capacity-dmips-mhz = <0x400>;
			dynamic-power-coefficient = <0x64>;
			phandle = <0x1a>;

			l2-cache {
				compatible = "arm,arch-cache";
				cache-level = <0x02>;
				next-level-cache = <0x07>;
				phandle = <0x0d>;
			};

			l1-icache {
				compatible = "arm,arch-cache";
				phandle = <0x230>;
			};

			l1-dcache {
				compatible = "arm,arch-cache";
				phandle = <0x231>;
			};
		};

		cpu@400 {
			device_type = "cpu";
			compatible = "qcom,kryo";
			reg = <0x00 0x400>;
			enable-method = "psci";
			cpu-idle-states = <0x0e>;
			power-domains = <0x0f>;
			power-domain-names = "psci";
			cpu-release-addr = <0x00 0x90000000>;
			next-level-cache = <0x10>;
			qcom,freq-domain = <0x06 0x01>;
			capacity-dmips-mhz = <0x766>;
			dynamic-power-coefficient = <0x215>;
			#cooling-cells = <0x02>;
			phandle = <0x1b>;

			l2-cache {
				compatible = "arm,arch-cache";
				cache-level = <0x02>;
				next-level-cache = <0x07>;
				phandle = <0x10>;
			};

			l1-icache {
				compatible = "arm,arch-cache";
				phandle = <0x232>;
			};

			l1-dcache {
				compatible = "arm,arch-cache";
				phandle = <0x233>;
			};
		};

		cpu@500 {
			device_type = "cpu";
			compatible = "qcom,kryo";
			reg = <0x00 0x500>;
			enable-method = "psci";
			cpu-idle-states = <0x0e>;
			power-domains = <0x11>;
			power-domain-names = "psci";
			cpu-release-addr = <0x00 0x90000000>;
			next-level-cache = <0x12>;
			qcom,freq-domain = <0x06 0x01>;
			capacity-dmips-mhz = <0x766>;
			dynamic-power-coefficient = <0x215>;
			phandle = <0x1c>;

			l2-cache {
				compatible = "arm,arch-cache";
				cache-level = <0x02>;
				next-level-cache = <0x07>;
				phandle = <0x12>;
			};

			l1-icache {
				compatible = "arm,arch-cache";
