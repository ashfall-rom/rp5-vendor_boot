			};

			l1-dcache {
				compatible = "arm,arch-cache";
				phandle = <0x235>;
			};
		};

		cpu@600 {
			device_type = "cpu";
			compatible = "qcom,kryo";
			reg = <0x00 0x600>;
			enable-method = "psci";
			cpu-idle-states = <0x0e>;
			power-domains = <0x13>;
			power-domain-names = "psci";
			cpu-release-addr = <0x00 0x90000000>;
			next-level-cache = <0x14>;
			qcom,freq-domain = <0x06 0x01>;
			capacity-dmips-mhz = <0x766>;
			dynamic-power-coefficient = <0x215>;
			phandle = <0x1d>;

			l2-cache {
				compatible = "arm,arch-cache";
				cache-level = <0x02>;
				next-level-cache = <0x07>;
				phandle = <0x14>;
			};

			l1-icache {
				compatible = "arm,arch-cache";
				phandle = <0x236>;
			};

			l1-dcache {
				compatible = "arm,arch-cache";
				phandle = <0x237>;
			};
		};

		cpu@700 {
			device_type = "cpu";
			compatible = "qcom,kryo";
			reg = <0x00 0x700>;
			enable-method = "psci";
			cpu-idle-states = <0x0e>;
			power-domains = <0x15>;
			power-domain-names = "psci";
			cpu-release-addr = <0x00 0x90000000>;
			next-level-cache = <0x16>;
			qcom,freq-domain = <0x06 0x02>;
			capacity-dmips-mhz = <0x766>;
			dynamic-power-coefficient = <0x282>;
			#cooling-cells = <0x02>;
			phandle = <0x1e>;

			l2-cache {
				compatible = "arm,arch-cache";
				cache-level = <0x02>;
				next-level-cache = <0x07>;
				phandle = <0x16>;
			};

			l1-icache {
				compatible = "arm,arch-cache";
				phandle = <0x238>;
			};

			l1-dcache {
				compatible = "arm,arch-cache";
				phandle = <0x239>;
			};
		};

		cpu-map {

			cluster0 {

				core0 {
					cpu = <0x17>;
				};

				core1 {
					cpu = <0x18>;
				};

				core2 {
					cpu = <0x19>;
				};

				core3 {
					cpu = <0x1a>;
				};
			};

			cluster1 {

				core0 {
					cpu = <0x1b>;
				};

				core1 {
					cpu = <0x1c>;
				};

				core2 {
					cpu = <0x1d>;
				};
			};

			cluster2 {

				core0 {
					cpu = <0x1e>;
				};
			};
		};
	};

	idle-states {
		entry-method = "psci";

		silver-c4 {
			compatible = "arm,idle-state";
			idle-state-name = "rail-pc";
			entry-latency-us = <0x168>;
			exit-latency-us = <0x213>;
			min-residency-us = <0xf5e>;
			arm,psci-suspend-param = <0x40000004>;
			local-timer-stop;
			phandle = <0x03>;
		};

		gold-c4 {
			compatible = "arm,idle-state";
			idle-state-name = "rail-pc";
			entry-latency-us = <0x2be>;
			exit-latency-us = <0x425>;
			min-residency-us = <0x1188>;
			arm,psci-suspend-param = <0x40000004>;
			local-timer-stop;
			phandle = <0x0e>;
		};

		cluster-e3 {
			compatible = "domain-idle-state";
			idle-state-name = "llcc-off";
			entry-latency-us = <0xcbf>;
			exit-latency-us = <0x19a2>;
			min-residency-us = <0x2703>;
			arm,psci-suspend-param = <0x4100c344>;
			phandle = <0x214>;
		};
	};

	soc {
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		ranges = <0x00 0x00 0x00 0xffffffff>;
		compatible = "simple-bus";
		phandle = <0x23a>;

		thermal-zones {
			phandle = <0x23b>;

			pm8150_tz {
				polling-delay-passive = <0x64>;
				polling-delay = <0x00>;
				thermal-sensors = <0x1f>;
				phandle = <0x23c>;

				trips {

					trip0 {
						temperature = <0x19a28>;
						hysteresis = <0x00>;
						type = "passive";
						phandle = <0x23d>;
					};

					trip1 {
						temperature = <0x1e848>;
						hysteresis = <0x00>;
						type = "passive";
						phandle = <0x23e>;
					};

					trip2 {
						temperature = <0x25d78>;
						hysteresis = <0x00>;
						type = "critical";
					};
				};
			};

			pm8150b_tz {
				polling-delay-passive = <0x64>;
				polling-delay = <0x00>;
				thermal-sensors = <0x20>;
				phandle = <0x23f>;

				trips {

					trip0 {
						temperature = <0x17318>;
						hysteresis = <0x00>;
						type = "passive";
						phandle = <0x240>;
					};

					trip1 {
						temperature = <0x1c138>;
						hysteresis = <0x00>;
						type = "passive";
						phandle = <0x241>;
					};

					trip2 {
						temperature = <0x23668>;
						hysteresis = <0x00>;
						type = "passive";
					};
				};
			};

			pm8150b-ibat-lvl0 {
				polling-delay-passive = <0x00>;
				polling-delay = <0x00>;
				thermal-sensors = <0x21 0x00>;

				trips {

					ibat-lvl0 {
						temperature = <0x1194>;
						hysteresis = <0xc8>;
						type = "passive";
						phandle = <0x242>;
					};
				};
			};

			pm8150b-ibat-lvl1 {
				polling-delay-passive = <0x00>;
				polling-delay = <0x00>;
				thermal-sensors = <0x21 0x01>;

				trips {

					ibat-lvl1 {
						temperature = <0x1388>;
						hysteresis = <0xc8>;
						type = "passive";
						phandle = <0x243>;
					};
				};
			};

			pm8150b-bcl-lvl0 {
				polling-delay-passive = <0x64>;
				polling-delay = <0x00>;
				thermal-sensors = <0x21 0x05>;

