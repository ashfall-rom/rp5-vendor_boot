		rsc@af20000 {
			label = "disp_rsc";
			compatible = "qcom,rpmh-rsc";
			reg = <0xaf20000 0x10000>;
			reg-names = "drv-0";
			qcom,drv-count = <0x01>;
			interrupts = <0x00 0x81 0x04>;
			clocks = <0x75 0x2a>;
			phandle = <0x2ac>;

			drv@0 {
				qcom,drv-id = <0x00>;
				qcom,tcs-offset = <0x1c00>;
				phandle = <0x2ad>;

				channel@0 {
					qcom,tcs-config = <0x02 0x00 0x00 0x01 0x01 0x01 0x03 0x00 0x04 0x00>;
				};

				bcm_voter {
					compatible = "qcom,bcm-voter";
					qcom,tcs-wait = <0x01>;
					phandle = <0x86>;
				};

				sde_rsc_rpmh {
					cell-index = <0x00>;
					compatible = "qcom,sde-rsc-rpmh";
				};
			};
		};

		interrupt-controller@b220000 {
			compatible = "qcom,pdc\0qcom,kona-pdc";
			reg = <0xb220000 0x30000 0x17c000f0 0x60>;
			qcom,pdc-ranges = <0x00 0x1e0 0x5e 0x5e 0x261 0x1f 0x7d 0x3f 0x01 0x7e 0x2cc 0x0c>;
			#interrupt-cells = <0x02>;
			interrupt-parent = <0x01>;
			interrupt-controller;
			phandle = <0x5a>;
		};

		qcom,cpu-vendor-hooks {
			compatible = "qcom,cpu-vendor-hooks";
			phandle = <0x2ae>;
		};

		clocks {

			xo-board {
				compatible = "fixed-clock";
				#clock-cells = <0x00>;
				clock-frequency = <0x249f000>;
				clock-output-names = "xo_board";
				phandle = <0x2af>;
			};

			sleep-clk {
				compatible = "fixed-clock";
				clock-frequency = <0x7d00>;
				clock-output-names = "sleep_clk";
				#clock-cells = <0x01>;
				phandle = <0x7d>;
			};

			usb3-phy-wrapper-gcc-usb30-pipe-clk {
				compatible = "fixed-clock";
				clock-frequency = <0x3e8>;
				clock-output-names = "usb3_phy_wrapper_gcc_usb30_pipe_clk";
				#clock-cells = <0x00>;
				phandle = <0x7b>;
			};

			usb3-uni-phy-sec-gcc-usb30-pipe-clk {
				compatible = "fixed-clock";
				clock-frequency = <0x3e8>;
				clock-output-names = "usb3_uni_phy_sec_gcc_usb30_pipe_clk";
				#clock-cells = <0x00>;
				phandle = <0x7c>;
			};
		};

		clock-controller@100000 {
			compatible = "qcom,gcc-sm8250\0syscon";
			reg = <0x100000 0x1f0000>;
			reg-names = "cc_base";
			vdd_cx-supply = <0x76>;
			vdd_cx_ao-supply = <0x77>;
			vdd_mm-supply = <0x72>;
			clocks = <0x5c 0x00 0x5c 0x01 0x78 0x79 0x7a 0x7b 0x7c 0x7d>;
			clock-names = "bi_tcxo\0bi_tcxo_ao\0pcie_0_pipe_clk\0pcie_1_pipe_clk\0pcie_2_pipe_clk\0usb3_phy_wrapper_gcc_usb30_pipe_clk\0usb3_uni_phy_sec_gcc_usb30_pipe_clk\0sleep_clk";
			#clock-cells = <0x01>;
			#reset-cells = <0x01>;
			phandle = <0x7e>;
		};

		clock-controller@9800000 {
			compatible = "qcom,sm8250-npucc\0syscon";
			reg = <0x9800000 0x190000>;
			reg-name = "cc_base";
